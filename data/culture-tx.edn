#:culture{:id "png.dish.mumu", :name "Mumu", :country "PNG", :kind :dish, :summary "Regarded as the national dish of Papua New Guinea: pork or chicken with sweet potato, taro, plantains and leafy vegetables cooked in an earth oven and wrapped in banana leaves; the mumu earth-oven cooking method is also found elsewhere in the Pacific.", :url "https://en.wikipedia.org/wiki/Papua_New_Guinean_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "png.dish.kokoda", :name "Kokoda", :country "PNG", :kind :dish, :summary "Papua New Guinean dish of fish cooked in a lime-coconut sauce, similar to ceviche; the same dish name is also present in Fijian cuisine.", :url "https://en.wikipedia.org/wiki/Papua_New_Guinean_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "png.dish.dia", :name "Dia", :country "PNG", :kind :dish, :summary "Papua New Guinean dessert of a sago-and-banana dumpling steamed in a banana-leaf wrapping and served with clotted coconut cream; also known as pariwa.", :url "https://en.wikipedia.org/wiki/Papua_New_Guinean_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "png.beverage.kulau", :name "Kulau", :country "PNG", :kind :beverage, :summary "A green coconut filled with sweet, slightly tangy coconut water, drunk as a traditional beverage in Papua New Guinea.", :url "https://en.wikipedia.org/wiki/Papua_New_Guinean_cuisine", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "png.craft.kundu", :name "Kundu", :country "PNG", :kind :craft, :summary "Hourglass drum used in Papua New Guinea to accompany formal occasions, religious ceremonies and celebrations, culturally significant enough to appear on the country's coat of arms.", :url "https://en.wikipedia.org/wiki/Kundu_(drum)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:url "https://en.wikipedia.org/wiki/Areca_nut", :id "png.product.betel-nut", :kind :product, :name-local "Buai", :country "PNG", :retrieved-at "2026-07-17", :summary "In Papua New Guinea, betel nuts are known in Tok Pisin as buai and grow abundantly on the northern coast around Wewak and Madang, where they are widely chewed; betel-nut chewing is a broader practice shared across parts of Asia and the Pacific, not exclusive to PNG.", :name "Betel nut", :url-provenance :wikipedia-en}
#:culture{:id "png.festival.goroka-show", :name "Goroka Show", :country "PNG", :kind :festival, :summary "Well-known tribal gathering and cultural event in Papua New Guinea held annually near the country's Independence Day in Goroka, where around 100 tribes showcase their music, dance and cultural traditions.", :url "https://en.wikipedia.org/wiki/Goroka_Show", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "png.heritage.kuk-swamp", :name "Kuk Swamp", :country "PNG", :kind :heritage, :summary "Archaeological site in the Western Highlands recognized in 2008 as a UNESCO World Heritage Site, as one of the places in the world where people independently developed agriculture.", :url "https://en.wikipedia.org/wiki/Kuk_Swamp", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
